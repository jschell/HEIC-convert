<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <RootNamespace>HEICAutoConverter</RootNamespace>
    <AssemblyName>HEICAutoConverter</AssemblyName>
    <Version>0.1.2</Version>
    <Authors>J. Schell</Authors>
    <Copyright>Copyright © 2026 J. Schell</Copyright>
    <Description>Automatically monitors folders and converts HEIC photos to JPG format in real-time.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Publish-only settings: applied via dotnet publish -p:PublishProfile=Release or CLI flags -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' Or '$(IsPublishing)' == 'true'">
    <SelfContained>true</SelfContained>
    <!-- Trimming disabled: Windows Forms is not compatible with trimming -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- WPF/WinForms native DLLs must be extracted to disk, not loaded from memory -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.10.2" />
    <PackageReference Include="Magick.NET.Core" Version="14.10.2" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </ApplicationDefinition>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\icon.ico" />
  </ItemGroup>

  <!-- Exclude test files from main project -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
