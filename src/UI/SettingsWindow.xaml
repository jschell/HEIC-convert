<Window x:Class="HEICAutoConverter.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HEIC Auto Converter - Settings"
        Width="600" Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinWidth="500" MinHeight="550"
        Icon="/assets/icon.ico">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="Button" x:Key="SmallButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Watch Folders -->
                <GroupBox Header="Watch Folders">
                    <StackPanel>
                        <ListBox x:Name="FolderList" Height="100" Margin="0,0,0,8"
                                 SelectionMode="Single"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add Folder..." Click="OnAddFolder"
                                    Style="{StaticResource SmallButton}"/>
                            <Button Content="Remove" Click="OnRemoveFolder"
                                    Style="{StaticResource SmallButton}"/>
                        </StackPanel>
                        <CheckBox x:Name="IncludeSubdirs" Content="Include subdirectories"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Output Settings -->
                <GroupBox Header="Output Settings">
                    <StackPanel>
                        <RadioButton x:Name="OutputSameFolder" Content="Save JPG in same folder as source"
                                     GroupName="Output" Margin="0,0,0,6"
                                     Checked="OnOutputStrategyChanged"/>
                        <RadioButton x:Name="OutputCustomFolder" Content="Save to custom folder:"
                                     GroupName="Output" Margin="0,0,0,4"
                                     Checked="OnOutputStrategyChanged"/>
                        <DockPanel Margin="20,0,0,6">
                            <Button Content="Browse..." DockPanel.Dock="Right"
                                    Click="OnBrowseOutputFolder"
                                    Style="{StaticResource SmallButton}"/>
                            <TextBox x:Name="CustomOutputPath" Margin="0,0,4,0"
                                     IsEnabled="False"/>
                        </DockPanel>
                        <RadioButton x:Name="OutputMirror" Content="Mirror source directory structure in custom folder"
                                     GroupName="Output" Margin="0,0,0,0"
                                     Checked="OnOutputStrategyChanged"/>
                    </StackPanel>
                </GroupBox>

                <!-- File Handling -->
                <GroupBox Header="Original File Handling">
                    <StackPanel>
                        <RadioButton x:Name="ActionKeep" Content="Keep original HEIC files"
                                     GroupName="FileAction" Margin="0,0,0,6"/>
                        <RadioButton x:Name="ActionDelete" Content="Delete originals after conversion"
                                     GroupName="FileAction" Margin="0,0,0,6"/>
                        <RadioButton x:Name="ActionArchive" Content="Move originals to archive folder:"
                                     GroupName="FileAction" Margin="0,0,0,4"/>
                        <DockPanel Margin="20,0,0,0">
                            <Button Content="Browse..." DockPanel.Dock="Right"
                                    Click="OnBrowseArchiveFolder"
                                    Style="{StaticResource SmallButton}"/>
                            <TextBox x:Name="ArchivePath" Margin="0,0,4,0"
                                     IsEnabled="False"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Conversion Settings -->
                <GroupBox Header="Conversion Settings">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="JPEG Quality:" VerticalAlignment="Center"
                                       Width="100"/>
                            <TextBlock x:Name="QualityLabel" Text="95"
                                       VerticalAlignment="Center" Width="30"
                                       DockPanel.Dock="Right" TextAlignment="Right"/>
                            <Slider x:Name="QualitySlider" Minimum="1" Maximum="100"
                                    Value="95" IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="OnQualityChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Max Concurrent:" VerticalAlignment="Center"
                                       Width="100"/>
                            <TextBlock x:Name="ConcurrencyLabel" Text="2"
                                       VerticalAlignment="Center" Width="30"
                                       DockPanel.Dock="Right" TextAlignment="Right"/>
                            <Slider x:Name="ConcurrencySlider" Minimum="1" Maximum="8"
                                    Value="2" IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="OnConcurrencyChanged"/>
                        </DockPanel>
                        <CheckBox x:Name="SkipExisting"
                                  Content="Skip conversion if JPG already exists"/>
                    </StackPanel>
                </GroupBox>

                <!-- Behavior -->
                <GroupBox Header="Behavior">
                    <StackPanel>
                        <CheckBox x:Name="StartWithWindows"
                                  Content="Start with Windows" Margin="0,0,0,6"/>
                        <CheckBox x:Name="StartMinimized"
                                  Content="Start minimized to system tray" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ShowNotifications"
                                  Content="Show notification when conversion completes"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save" Click="OnSave" Width="90" Padding="0,6"
                    IsDefault="True" Margin="0,0,8,0"/>
            <Button Content="Cancel" Click="OnCancel" Width="90" Padding="0,6"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
